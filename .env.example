# Toast API credentials — copy to `.env` and fill in. NEVER commit the real .env.
#
# These come from your Toast partner/integration account.
# The client ID/secret authenticate via the standard machine-client flow.

# API host. Production: https://ws-api.toasttab.com
#           Sandbox:    https://ws-sandbox-api.toasttab.com
TOAST_API_HOST=https://ws-api.toasttab.com

# Machine client credentials (OAuth client-credentials flow)
TOAST_CLIENT_ID=your-client-id-here
TOAST_CLIENT_SECRET=your-client-secret-here

# Access type sent with the auth request. For standard integrations this is
# TOAST_MACHINE_CLIENT.
TOAST_USER_ACCESS_TYPE=TOAST_MACHINE_CLIENT

# Comma-separated list of restaurant GUIDs to pull, OR leave blank and define
# them (with friendly names) in config.yaml under `locations:`.
# TOAST_RESTAURANT_GUIDS=guid-location-a,guid-location-b
